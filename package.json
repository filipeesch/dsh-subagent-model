{
  "name": "dsh-subagent-model",
  "version": "0.4.0",
  "description": "Model-selection subagent delegation tools for DeepSeek Harness: list_subagent_routes + subagent_model (per-call provider/model/effort override and optional context inheritance).",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "plugin",
    "subagent",
    "model"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipeesch/dsh-subagent-model.git"
  },
  "homepage": "https://github.com/filipeesch/dsh-subagent-model#readme",
  "bugs": {
    "url": "https://github.com/filipeesch/dsh-subagent-model/issues"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "smoke:github": "node scripts/smoke-github.mjs"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
